    "colors": {
      "label": "Colors.*",
      "pattern": "(?<![A-Za-z0-9_])Colors\\."
    },
    "text_style": {
      "label": "TextStyle(",
      "pattern": "TextStyle\\("
    },
    "font_size": {
      "label": "fontSize:",
      "pattern": "fontSize:"
    },
    "radius": {
      "label": "BorderRadius.circular(",
      "pattern": "BorderRadius\\.circular\\("
    },
    "edge_all": {
      "label": "EdgeInsets.all(",
      "pattern": "EdgeInsets\\.all\\("
    },
    "edge_sym": {
      "label": "EdgeInsets.symmetric(",
      "pattern": "EdgeInsets\\.symmetric\\("
    },
    "sized_box": {
      "label": "SizedBox(height|width:",
