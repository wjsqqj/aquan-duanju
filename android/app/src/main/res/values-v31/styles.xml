<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting (API 31+).
         Android 12+ 系统 SplashScreen：品牌橙底 + 中央跑步机虚线动效图标
         （splash_walk_avd，与 Flutter 端 GroundDashes 同语言），Flutter 首帧后
         系统自动摘除；windowBackground 与 values/styles.xml 的 LaunchTheme
         保持一致，仅追加 splash 相关 item（design §4.1）。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_walk_avd</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         v31 覆盖：splash 相关 + windowBackground 换成启动橙——启动页摘除到
         Flutter 首帧之间、以及退出应用的瞬间，窗口底色不再回白。 -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_screen_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
    </style>
</resources>
